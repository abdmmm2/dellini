# متغيرات البيئة لمنصة دلني
# انسخ هذا الملف إلى .env وشيل التعليقات

# ---------- الموقع ----------
SITE_NAME=دلني
SITE_URL=http://localhost:3000
PORT=3000

# ---------- قاعدة البيانات ----------
# محليًا: يحذفها gitignore, يخليها في مجلد المشروع
# DB_PATH=./dellini.db
# على Render مع Persistent Disk:
# DB_PATH=/data/dellini.db
# UPLOADS_DIR=/data

# ---------- الأمان ----------
SESSION_SECRET=غيّر-هذه-الكلمة-إلى-كلمة-عشوائية-طويلة

# ---------- الدفع (اختياري - اتركها فاضية لوضع المحاكاة) ----------
# Stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# STC Pay
# DELLINI_MERCHANT=your_merchant_id
# DELLINI_API_KEY=your_api_key

# ---------- الإيميل (اختياري) ----------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=noreply@dellini.com

# ---------- النشر ----------
# SEED=true   <- أول تشغيل فقط عشان البذور، بعدين امسحها
# NODE_ENV=production
