<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <i class="bi bi-person-plus" style="font-size: 3rem; color: var(--primary);"></i>
            <h3 class="fw-bold mt-2">إنشاء حساب جديد</h3>
            <p class="text-muted">انضم إلى منصة دلني للاستشارات</p>
          </div>

          <form action="/register" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label">الاسم الكامل *</label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-person"></i></span>
                  <input type="text" name="name" class="form-control" required placeholder="الاسم الثلاثي">
                </div>
              </div>

              <div class="col-md-6 mb-3">
                <label class="form-label">رقم الجوال</label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-phone"></i></span>
                  <input type="tel" name="phone" class="form-control" placeholder="05xxxxxxxx">
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">البريد الإلكتروني *</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input type="email" name="email" class="form-control" required placeholder="example@email.com">
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label">كلمة المرور *</label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-lock"></i></span>
                  <input type="password" name="password" class="form-control" required minlength="6" placeholder="أقل شيء 6 أحرف">
                </div>
              </div>

              <div class="col-md-6 mb-3">
                <label class="form-label">تأكيد كلمة المرور *</label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                  <input type="password" name="confirm_password" class="form-control" required minlength="6" placeholder="أعد إدخال كلمة المرور">
                </div>
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label">نوع الحساب *</label>
              <div class="d-flex gap-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="role" value="client" id="roleClient" checked onchange="toggleIdUpload()">
                  <label class="form-check-label" for="roleClient">
                    <i class="bi bi-person"></i> عميل
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="role" value="consultant" id="roleConsultant" onchange="toggleIdUpload()">
                  <label class="form-check-label" for="roleConsultant">
                    <i class="bi bi-person-badge"></i> مستشار
                  </label>
                </div>
              </div>
            </div>

            <!-- 🆔 رفع الهوية الوطنية (للعملاء فقط) — مخفي عن المستخدم، يظهر للإدارة فقط -->
            <div class="mb-4" id="idUploadSection">
              <label class="form-label fw-bold">
                <i class="bi bi-card-text text-primary"></i> الهوية الوطنية <span class="text-danger">*</span>
              </label>
              <div class="card border-0 bg-light p-3" style="border-radius:12px">
                <div class="text-center mb-2" id="idCameraBtn">
                  <button type="button" class="btn btn-outline-primary btn-sm" onclick="openIdCamera()">
                    <i class="bi bi-camera"></i> تصوير الهوية
                  </button>
                  <p class="small text-muted mt-1 mb-0">أو اختر من المعرض</p>
                </div>
                <!-- Camera preview -->
                <div id="idCameraPreview" style="display:none">
                  <video id="idVideo" autoplay playsinline style="width:100%;max-height:250px;border-radius:12px;background:#000"></video>
                  <div class="d-flex gap-2 mt-2">
                    <button type="button" class="btn btn-success btn-sm flex-fill" onclick="captureIdPhoto()">
                      <i class="bi bi-camera"></i> تصوير
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="closeIdCamera()">
                      <i class="bi bi-x-lg"></i> إلغاء
                    </button>
                  </div>
                </div>
                <!-- Preview after capture -->
                <div id="idPhotoPreview" style="display:none">
                  <canvas id="idCanvas" style="width:100%;max-height:250px;border-radius:12px"></canvas>
                  <div class="d-flex gap-2 mt-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="retakeIdPhoto()">
                      <i class="bi bi-arrow-counterclockwise"></i> إعادة التصوير
                    </button>
                  </div>
                </div>
                <input type="file" name="national_id" id="nationalIdInput" accept="image/*" class="form-control form-control-sm mt-2" style="display:none">
                <input type="hidden" name="id_photo_data" id="idPhotoData">
                <small class="text-muted mt-1">صور الهوية مشفرة وآمنة 🔒</small>
              </div>
            </div>

            <script>
            let idStream = null;
            function openIdCamera() {
              document.getElementById('idCameraBtn').style.display = 'none';
              document.getElementById('idCameraPreview').style.display = 'block';
              document.getElementById('nationalIdInput').style.display = 'none';
              navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } } })
                .then(stream => {
                  idStream = stream;
                  document.getElementById('idVideo').srcObject = stream;
                })
                .catch(() => {
                  document.getElementById('nationalIdInput').click();
                });
            }
            function captureIdPhoto() {
              const video = document.getElementById('idVideo');
              const canvas = document.getElementById('idCanvas');
              canvas.width = video.videoWidth || 1280;
              canvas.height = video.videoHeight || 720;
              canvas.getContext('2d').drawImage(video, 0, 0);
              // Save as base64
              document.getElementById('idPhotoData').value = canvas.toDataURL('image/jpeg', 0.8);
              closeIdCamera();
              document.getElementById('idPhotoPreview').style.display = 'block';
              document.getElementById('idCameraBtn').style.display = 'none';
              document.getElementById('nationalIdInput').style.display = 'none';
            }
            function closeIdCamera() {
              if (idStream) { idStream.getTracks().forEach(t => t.stop()); idStream = null; }
              document.getElementById('idCameraPreview').style.display = 'none';
            }
            function retakeIdPhoto() {
              document.getElementById('idPhotoPreview').style.display = 'none';
              document.getElementById('idPhotoData').value = '';
              openIdCamera();
            }
            function toggleIdUpload() {
              const isClient = document.getElementById('roleClient').checked;
              document.getElementById('idUploadSection').style.display = isClient ? 'block' : 'none';
            }
            toggleIdUpload();
            </script>

            <button type="submit" class="btn btn-primary w-100 btn-lg mb-3">
              <i class="bi bi-person-plus"></i> إنشاء الحساب
            </button>

            <div class="text-center">
              <p class="mb-0">لديك حساب بالفعل؟ <a href="/login" class="fw-bold">تسجيل الدخول</a></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
