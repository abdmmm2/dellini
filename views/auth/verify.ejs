<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card shadow" style="border-radius:14px">
        <div class="card-body p-4 text-center">
          <div style="width:80px;height:80px;background:linear-gradient(135deg,#1a2332,#2a3a5c);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 15px;">
            <span style="color:#c8a45c;font-size:36px;font-weight:900;">د</span>
          </div>
          <h4 class="fw-bold">تأكيد الحساب</h4>
          
          <div class="row g-2 mt-3">
            <!-- Email Option -->
            <div class="col-6">
              <div class="card border-0 bg-light p-3 h-100" style="border-radius:12px">
                <i class="bi bi-envelope fs-2 text-primary"></i>
                <h6 class="fw-bold mt-2 mb-1">البريد الإلكتروني</h6>
                <p class="small text-muted mb-2">تم إرسال الرمز إلى <strong class="text-dark"><%= email %></strong></p>
                <form action="/verify" method="POST">
                  <input type="hidden" name="email" value="<%= email %>">
                  <input type="text" name="code" class="form-control form-control-sm text-center mb-2" 
                    style="font-size:20px;letter-spacing:6px;font-family:monospace;direction:ltr;" 
                    maxlength="6" placeholder="000000" inputmode="numeric">
                  <button type="submit" class="btn btn-primary btn-sm w-100">تأكيد</button>
                </form>
                <div class="mt-2">
                  <a href="/resend-code?email=<%= encodeURIComponent(email) %>" class="small">إعادة الإرسال</a>
                </div>
              </div>
            </div>

            <!-- WhatsApp Option -->
            <div class="col-6">
              <div class="card border-0 bg-light p-3 h-100" style="border-radius:12px;border:2px solid #25D366 !important">
                <i class="bi bi-whatsapp fs-2" style="color:#25D366"></i>
                <h6 class="fw-bold mt-2 mb-1">واتساب</h6>
                <p class="small text-muted mb-2">استلم الرمز عبر واتساب</p>
                <% if (typeof wa !== 'undefined' && wa) { %>
                  <a href="<%= wa %>" target="_blank" class="btn btn-success btn-sm w-100" style="background:#25D366;border:none;">
                    <i class="bi bi-whatsapp"></i> فتح واتساب
                  </a>
                  <p class="small text-muted mt-2 mb-0">الرمز: <strong style="font-size:18px;letter-spacing:4px;direction:ltr" class="text-dark"><%= typeof code !== 'undefined' ? code : '------' %></strong></p>
                <% } else { %>
                  <p class="small text-muted">غير متاح حاليًا</p>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>