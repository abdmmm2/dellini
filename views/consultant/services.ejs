<div class="container-fluid py-4 px-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0"><i class="bi bi-bookmark-check text-success"></i> خدماتي الاستشارية</h3>
    <button class="btn btn-outline-success btn-sm" onclick="document.getElementById('allServicesSection').scrollIntoView({behavior:'smooth'})">
      <i class="bi bi-plus-lg"></i> إضافة خدمة
    </button>
  </div>

  <!-- My assigned services -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
      <h5 class="fw-bold mb-0"><i class="bi bi-check2-circle text-success"></i> خدماتي الحالية</h5>
      <span class="badge bg-success"><%= myServices.length %></span>
    </div>
    <div class="card-body">
      <% if (myServices.length === 0) { %>
        <div class="text-center text-muted py-4">
          <i class="bi bi-inbox fs-1"></i>
          <p class="mb-0">لم تضف أي خدمة بعد. أضف خدماتك من الأسفل.</p>
        </div>
      <% } else { %>
        <div class="row g-2">
          <% myServices.forEach(sv => { %>
            <div class="col-md-4 col-6">
              <div class="border rounded p-3 bg-light position-relative">
                <button class="btn btn-sm text-danger position-absolute top-0 end-0 m-1" onclick="toggleService(<%= sv.service_id %>, 'remove')" title="إزالة">
                  <i class="bi bi-x-lg"></i>
                </button>
                <div class="mb-2">
                  <i class="bi <%= sv.icon %> text-success fs-5"></i>
                </div>
                <div class="fw-bold small"><%= sv.name_ar %></div>
                <small class="text-muted"><%= sv.category_name %></small>
                <div class="mt-2">
                  <div class="input-group input-group-sm">
                    <span class="input-group-text">ريال</span>
                    <input type="number" class="form-control form-control-sm price-input" 
                      value="<%= sv.price || '' %>" 
                      data-service-id="<%= sv.service_id %>"
                      placeholder="السعر">
                    <button class="btn btn-sm btn-outline-primary save-price" 
                      data-service-id="<%= sv.service_id %>">
                      <i class="bi bi-check2"></i>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- All services available to add -->
  <div class="card shadow-sm" id="allServicesSection">
    <div class="card-header bg-white">
      <h5 class="fw-bold mb-0"><i class="bi bi-grid"></i> جميع الخدمات المتاحة</h5>
    </div>
    <div class="card-body p-2">
      <% const grouped = {}; %>
      <% allServices.forEach(sv => { %>
        <% if (!grouped[sv.cat_name]) grouped[sv.cat_name] = []; %>
        <% grouped[sv.cat_name].push(sv); %>
      <% }) %>
      
      <% Object.keys(grouped).forEach(catName => { %>
        <h6 class="fw-bold mt-3 mb-2 px-2"><i class="bi bi-folder text-primary"></i> <%= catName %></h6>
        <div class="row g-2">
          <% grouped[catName].forEach(sv => { %>
            <div class="col-md-3 col-6">
              <div class="border rounded p-2 <%= sv.is_assigned ? 'border-success bg-success bg-opacity-10' : '' %>" 
                   id="serviceCard_<%= sv.id %>"
                   style="cursor:pointer;transition:all 0.2s;"
                   onclick="toggleService(<%= sv.id %>, '<%= sv.is_assigned ? 'remove' : 'add' %>')">
                <div class="d-flex align-items-center gap-2">
                  <i class="bi <%= sv.icon %> <%= sv.is_assigned ? 'text-success' : 'text-muted' %>"></i>
                  <div>
                    <div class="small fw-bold"><%= sv.name_ar %></div>
                    <small class="text-muted" style="font-size:0.65rem;"><%= sv.description || '' %></small>
                  </div>
                </div>
                <div class="mt-1">
                  <% if (sv.is_assigned) { %>
                    <span class="badge bg-success" style="font-size:0.6rem;">مضافة ✓</span>
                  <% } else { %>
                    <span class="badge bg-secondary" style="font-size:0.6rem;">إضافة +</span>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<script>
function toggleService(serviceId, action) {
  const card = document.getElementById('serviceCard_' + serviceId);
  if (action === 'add') {
    card.classList.remove('border-secondary');
    card.classList.add('border-success', 'bg-success', 'bg-opacity-10');
    card.querySelector('.badge').className = 'badge bg-success';
    card.querySelector('.badge').textContent = 'مضافة ✓';
    card.querySelector('i.bi').className = 'bi bi-check-circle-fill text-success';
    card.setAttribute('onclick', `toggleService(${serviceId}, 'remove')`);
  } else {
    card.classList.remove('border-success', 'bg-success', 'bg-opacity-10');
    card.classList.add('border-secondary');
    card.querySelector('.badge').className = 'badge bg-secondary';
    card.querySelector('.badge').textContent = 'إضافة +';
    card.querySelector('i.bi').className = 'bi bi-plus-circle text-muted';
    card.setAttribute('onclick', `toggleService(${serviceId}, 'add')`);
  }
  
  fetch('/consultant/services/toggle', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ service_id: serviceId, action: action })
  }).catch(() => {});
}

// Save price on button click
document.querySelectorAll('.save-price').forEach(btn => {
  btn.addEventListener('click', function() {
    const serviceId = this.dataset.serviceId;
    const input = document.querySelector(`.price-input[data-service-id="${serviceId}"]`);
    const price = input.value;
    
    fetch('/consultant/services/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ service_id: parseInt(serviceId), action: 'price', price: parseFloat(price) || null })
    }).then(r => r.json()).then(d => {
      if (d.success) {
        this.classList.remove('btn-outline-primary');
        this.classList.add('btn-success');
        setTimeout(() => {
          this.classList.remove('btn-success');
          this.classList.add('btn-outline-primary');
        }, 1500);
      }
    });
  });
});

// Auto-save price on enter
document.querySelectorAll('.price-input').forEach(input => {
  input.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      this.parentElement.querySelector('.save-price').click();
    }
  });
});
</script>
