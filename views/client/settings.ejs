<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-sm" style="border-radius:14px">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3"><i class="bi bi-gear"></i> إعدادات الحساب</h5>
          
          <!-- الهوية الوطنية -->
          <div class="mb-3">
            <h6 class="fw-bold"><i class="bi bi-card-text text-primary"></i> الهوية الوطنية</h6>
            <p class="small text-muted">ارفع صورتك للهوية الوطنية للمراجعة من قبل الإدارة.</p>
            
            <% if (identity && identity.image_path) { %>
              <div class="mb-2">
                <span class="badge <%= identity.status === 'verified' ? 'bg-success' : identity.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark' %>">
                  <%= identity.status === 'verified' ? '✅ تم التوثيق' : identity.status === 'rejected' ? '❌ مرفوض' : '⏳ قيد المراجعة' %>
                </span>
              </div>
            <% } %>
            
            <form method="POST" action="/client/settings/upload-id" enctype="multipart/form-data" id="idForm">
              <div class="text-center mb-2" id="idCameraBtn">
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="openIdCamera()">
                  <i class="bi bi-camera"></i> تصوير الهوية
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('nationalIdInput').click()">
                  <i class="bi bi-folder"></i> اختيار من المعرض
                </button>
              </div>
              <div id="idCameraPreview" style="display:none">
                <video id="idVideo" autoplay playsinline style="width:100%;max-height:250px;border-radius:12px;background:#000"></video>
                <div class="d-flex gap-2 mt-2">
                  <button type="button" class="btn btn-success btn-sm flex-fill" onclick="captureIdPhoto()">
                    <i class="bi bi-camera"></i> تصوير
                  </button>
                  <button type="button" class="btn btn-outline-secondary btn-sm" onclick="closeIdCamera()">
                    <i class="bi bi-x-lg"></i> إلغاء
                  </button>
                </div>
              </div>
              <div id="idPhotoPreview" style="display:none">
                <canvas id="idCanvas" style="width:100%;max-height:250px;border-radius:12px"></canvas>
                <div class="d-flex gap-2 mt-2">
                  <button type="button" class="btn btn-outline-primary btn-sm" onclick="retakeIdPhoto()">
                    <i class="bi bi-arrow-counterclockwise"></i> إعادة التصوير
                  </button>
                </div>
              </div>
              <input type="file" name="national_id" id="nationalIdInput" accept="image/*" class="form-control form-control-sm mt-2" style="display:none">
              <input type="hidden" name="id_photo_data" id="idPhotoData">
              <button type="submit" class="btn btn-primary btn-sm mt-2"><i class="bi bi-upload"></i> حفظ</button>
            </form>

            <script>
            let idStream = null;
            function openIdCamera() {
              document.getElementById('idCameraBtn').style.display = 'none';
              document.getElementById('idCameraPreview').style.display = 'block';
              document.getElementById('nationalIdInput').style.display = 'none';
              navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } } })
                .then(stream => { idStream = stream; document.getElementById('idVideo').srcObject = stream; })
                .catch(() => { document.getElementById('nationalIdInput').click(); });
            }
            function captureIdPhoto() {
              const video = document.getElementById('idVideo');
              const canvas = document.getElementById('idCanvas');
              canvas.width = video.videoWidth || 1280;
              canvas.height = video.videoHeight || 720;
              canvas.getContext('2d').drawImage(video, 0, 0);
              document.getElementById('idPhotoData').value = canvas.toDataURL('image/jpeg', 0.8);
              closeIdCamera();
              document.getElementById('idPhotoPreview').style.display = 'block';
              document.getElementById('idCameraBtn').style.display = 'none';
            }
            function closeIdCamera() {
              if (idStream) { idStream.getTracks().forEach(t => t.stop()); idStream = null; }
              document.getElementById('idCameraPreview').style.display = 'none';
            }
            function retakeIdPhoto() {
              document.getElementById('idPhotoPreview').style.display = 'none';
              document.getElementById('idPhotoData').value = '';
              openIdCamera();
            }
            document.getElementById('idForm').addEventListener('submit', function(e) {
              if (!document.getElementById('nationalIdInput').files.length && !document.getElementById('idPhotoData').value) {
                e.preventDefault();
                alert('يرجى تصوير الهوية أو اختيار صورة');
              }
            });
            </script>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>