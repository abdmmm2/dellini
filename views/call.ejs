<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🎧 مكالمة #<%= consultation.id %> — دلني</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:system-ui,sans-serif; background:#1a2332; color:#fff; min-height:100vh; }
    .call-header {
      background:linear-gradient(135deg,#1a2332,#2a3a5c); padding:15px 20px;
      display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.1);
    }
    .call-header h6 { margin:0; font-weight:700; }
    .options { padding:20px; max-width:500px; margin:0 auto; }
    .option-card {
      background:rgba(255,255,255,0.05); border-radius:16px; padding:20px;
      margin-bottom:12px; text-align:center; border:1px solid rgba(255,255,255,0.1);
      transition:all 0.3s;
    }
    .option-card:hover { background:rgba(255,255,255,0.1); transform:translateY(-2px); }
    .option-card .icon { font-size:2.5rem; margin-bottom:8px; }
    .option-card h6 { font-weight:700; margin-bottom:4px; }
    .option-card p { font-size:0.8rem; color:#999; margin-bottom:12px; }
    .btn-jitsi { background:#25D366; color:#fff; border:none; }
    .btn-jitsi:hover { background:#1da851; color:#fff; }
    .btn-whatsapp { background:#25D366; color:#fff; border:none; }
    .btn-whatsapp:hover { background:#1da851; color:#fff; }
    .btn-copy { background:#6c757d; border:none; }
    .room-id { font-family:monospace; direction:ltr; font-size:0.9rem; }
    .footer { text-align:center; padding:20px; color:#666; font-size:0.8rem; }
  </style>
</head>
<body>
  <div class="call-header">
    <div class="d-flex align-items-center gap-2">
      <span style="color:#c8a45c;font-weight:700;">دلني</span>
      <span class="badge bg-success"><i class="bi bi-telephone"></i> مكالمة صوتية</span>
    </div>
    <div>
      <a href="<%= backUrl %>" class="btn btn-outline-light btn-sm">✕ إنهاء</a>
    </div>
  </div>

  <div class="text-center py-2" style="background:rgba(255,255,255,0.03);border-bottom:1px solid rgba(255,255,255,0.05);">
    <small class="text-muted">
      <%= consultation.consultant_name || 'مستشار' %> 🎧 <%= consultation.client_name || 'عميل' %> 
      · استشارة #<%= consultation.id %>
    </small>
  </div>

  <div class="options">
    <!-- Option 1: Jitsi Meet -->
    <div class="option-card">
      <div class="icon">🎥</div>
      <h6>Jitsi Meet</h6>
      <p>منصة مكالمات مفتوحة — صوت وصورة</p>
      <a href="<%= meetingUrl %>" target="_blank" rel="noopener" class="btn btn-success w-100">
        <i class="bi bi-telephone-fill"></i> انضم عبر Jitsi
      </a>
    </div>

    <!-- Option 2: Copy room name -->
    <div class="option-card">
      <div class="icon">🔗</div>
      <h6>رابط المكالمة</h6>
      <p>انسخ الرابط وأرسله للطرف الآخر</p>
      <div class="input-group mb-2">
        <input type="text" class="form-control room-id" value="<%= meetingUrl %>" readonly id="meetLink" onclick="this.select()">
      </div>
      <button class="btn btn-secondary w-100" onclick="copyLink()">
        <i class="bi bi-clipboard"></i> نسخ الرابط
      </button>
    </div>

    <!-- Option 3: WhatsApp call (Saudi Arabia) -->
    <div class="option-card">
      <div class="icon">💬</div>
      <h6>واتساب</h6>
      <p>بديل: تواصل مباشر عبر واتساب</p>
      <a href="https://wa.me/966500000000?text=مكالمة%20استشارة%20#<%= consultation.id %>%20غرفة%20:<%= meetingUrl %>" target="_blank" class="btn btn-success w-100">
        <i class="bi bi-whatsapp"></i> فتح واتساب
      </a>
    </div>
  </div>

  <div class="footer">
    <p>إذا واجهت مشكلة في الاتصال، استخدم رابط Jitsi مباشرة أو واتساب</p>
  </div>

  <script>
    // Auto-open Jitsi in new tab after short delay
    setTimeout(() => {
      window.open('<%= meetingUrl %>', '_blank');
    }, 1500);

    function copyLink() {
      const input = document.getElementById('meetLink');
      input.select();
      input.setSelectionRange(0, 99999);
      navigator.clipboard.writeText(input.value).then(() => {
        alert('✅ تم نسخ الرابط');
      });
    }
  </script>
</body>
</html>