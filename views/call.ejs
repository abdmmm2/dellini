<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>🎧 مكالمة #<%= consultation.id %> — دلني</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://unpkg.com/simple-peer@9.11.1/simplepeer.min.js"></script>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:system-ui,sans-serif; background:#1a2332; color:#fff; height:100vh; display:flex; flex-direction:column; }
    .header {
      background:linear-gradient(135deg,#1a2332,#2a3a5c); padding:15px 20px;
      display:flex; justify-content:space-between; align-items:center;
    }
    .call-area { flex:1; display:flex; align-items:center; justify-content:center; flex-direction:column; padding:20px; text-align:center; }
    .avatar-big { width:100px;height:100px;border-radius:50%;background:linear-gradient(135deg,#0d6efd,#6610f2);
      display:flex;align-items:center;justify-content:center;font-size:3rem;font-weight:700;color:#fff;margin-bottom:15px; }
    .status { color:#999; font-size:0.9rem; margin-bottom:20px; }
    .status.connected { color:#22c55e; }
    .controls { display:flex; gap:20px; margin-top:20px; }
    .ctrl-btn {
      width:60px;height:60px;border-radius:50%;border:none;font-size:1.5rem;
      display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.3s;
    }
    .ctrl-btn:hover { transform:scale(1.1); }
    .ctrl-btn.mic { background:rgba(255,255,255,0.1); color:#fff; }
    .ctrl-btn.mic.muted { background:#dc3545; }
    .ctrl-btn.hangup { background:#dc3545; color:#fff; }
    .ctrl-btn.hangup:hover { background:#bb2d3b; }
    .waiting { color:#c8a45c; }
    .waiting .spinner { display:inline-block;width:30px;height:30px;border:3px solid rgba(200,164,92,0.3);
      border-radius:50%;border-top-color:#c8a45c;animation:spin 1s linear infinite; }
    @keyframes spin { to { transform:rotate(360deg); } }
    .fallback-link { margin-top:30px; padding-top:20px; border-top:1px solid rgba(255,255,255,0.1); }
    .fallback-link a { color:#c8a45c; font-size:0.85rem; }
  </style>
</head>
<body>
  <div class="header">
    <div>
      <span style="color:#c8a45c;font-weight:700;">دلني</span>
      <span class="badge bg-success ms-1">📞 مكالمة</span>
    </div>
    <div class="text-center">
      <strong><%= consultation.consultant_name || 'مستشار' %></strong>
      <span class="text-muted mx-1">🎧</span>
      <strong><%= consultation.client_name || 'عميل' %></strong>
    </div>
    <a href="<%= backUrl %>" class="btn btn-outline-light btn-sm">✕ خروج</a>
  </div>

  <div class="call-area">
    <div class="avatar-big" id="avatarIcon"><%= (displayName || 'م').charAt(0) %></div>
    <h5 id="peerName"><%= displayName %></h5>
    <div class="status" id="callStatus">
      <div class="waiting" id="waitingDiv">
        <div class="spinner"></div>
        <p class="mt-2">🔔 جاري الاتصال...</p>
        <p class="small text-muted mt-1">يُرسل إشعار للطرف الآخر</p>
      </div>
    </div>
    
    <div class="controls">
      <button class="ctrl-btn mic" id="micBtn" onclick="toggleMute()">
        <i class="bi bi-mic"></i>
      </button>
      <button class="ctrl-btn hangup" onclick="hangUp()">
        <i class="bi bi-telephone-x"></i>
      </button>
    </div>

    <div class="fallback-link">
      <p class="small text-muted mb-1">إذا لم تعمل المكالمة:</p>
      <a href="<%= meetingUrl %>" target="_blank" rel="noopener">🔗 فتح Jitsi Meet بديل</a>
    </div>
  </div>

  <script>
    const socket = io();
    const roomId = 'call_<%= consultation.id %>';
    let peer = null;
    let localStream = null;
    let isMuted = false;
    let ringtone = null;

    // 🔔 Ringtone generator (Web Audio API)
    function startRingtone() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        ringtone = { ctx, playing: true };
        playBeep(ctx, ringtone);
      } catch(e) { console.log('Ringtone unavailable'); }
    }
    function playBeep(ctx, state) {
      if (!state.playing) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(800, ctx.currentTime);
      osc.frequency.setValueAtTime(1000, ctx.currentTime + 0.3);
      gain.gain.setValueAtTime(0.3, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.6);
      osc.start(ctx.currentTime);
      osc.stop(ctx.currentTime + 0.6);
      setTimeout(() => playBeep(ctx, state), 1200);
    }
    function stopRingtone() {
      if (ringtone) { ringtone.playing = false; if (ringtone.ctx) ringtone.ctx.close(); ringtone = null; }
    }

    // Join room
    socket.emit('join-room', roomId);
    
    // Start ringing when waiting
    setTimeout(startRingtone, 500);
    
    // Get local audio stream
    async function startCall() {
      try {
        localStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        
        peer = new SimplePeer({ initiator: true, stream: localStream, trickle: false });
        
        peer.on('signal', signal => {
          socket.emit('signal', { roomId, signal });
        });
        
        peer.on('stream', remoteStream => {
          stopRingtone();
          // Remote audio plays automatically
          const audio = new Audio();
          audio.srcObject = remoteStream;
          audio.autoplay = true;
          audio.play();
          document.getElementById('callStatus').innerHTML = '<span class="connected">🟢 متصل</span>';
        });
        
        peer.on('error', err => {
          console.error('Peer error:', err);
          document.getElementById('callStatus').innerHTML = '<span style="color:#dc3545">❌ فشل الاتصال</span>';
        });
        
        peer.on('close', () => {
          document.getElementById('callStatus').innerHTML = '<span style="color:#999">🔇 انتهت المكالمة</span>';
        });
        
      } catch (err) {
        console.error('Media error:', err);
        document.getElementById('callStatus').innerHTML = '<span style="color:#dc3545">❌ لم نتمكن من الوصول للميكروفون</span>';
      }
    }

    // Listen for signals from other peer
    socket.on('signal', (data) => {
      if (!peer) {
        // We are the second peer (not initiator)
        startCallAsReceiver();
      }
      if (peer) {
        peer.signal(data.signal);
      }
    });
    
    async function startCallAsReceiver() {
      try {
        localStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        
        peer = new SimplePeer({ initiator: false, stream: localStream, trickle: false });
        
        peer.on('signal', signal => {
          socket.emit('signal', { roomId, signal });
        });
        
        peer.on('stream', remoteStream => {
          const audio = new Audio();
          audio.srcObject = remoteStream;
          audio.autoplay = true;
          audio.play();
          document.getElementById('callStatus').innerHTML = '<span class="connected">🟢 متصل</span>';
        });
        
        peer.on('error', err => {
          console.error('Peer error:', err);
        });
        
        peer.on('close', () => {
          document.getElementById('callStatus').innerHTML = '<span style="color:#999">🔇 انتهت المكالمة</span>';
        });
        
      } catch (err) {
        console.error('Media error:', err);
      }
    }

    socket.on('user-joined', () => {
      stopRingtone();
      document.getElementById('callStatus').innerHTML = '<span style="color:#22c55e">🟢 تم الاتصال، جاري التوصيل...</span>';
      startCall();
    });

    socket.on('user-left', () => {
      stopRingtone();
      if (peer) { peer.destroy(); peer = null; }
      document.getElementById('callStatus').innerHTML = '<span style="color:#999">🔇 الطرف الآخر غادر</span>';
    });

    function toggleMute() {
      if (localStream) {
        isMuted = !isMuted;
        localStream.getAudioTracks().forEach(t => t.enabled = !isMuted);
        document.getElementById('micBtn').innerHTML = isMuted ? '<i class="bi bi-mic-mute"></i>' : '<i class="bi bi-mic"></i>';
        document.getElementById('micBtn').classList.toggle('muted', isMuted);
      }
    }

    function hangUp() {
      if (localStream) localStream.getTracks().forEach(t => t.stop());
      if (peer) peer.destroy();
      socket.emit('leave-room', roomId);
      document.getElementById('callStatus').innerHTML = '<span style="color:#999">🔇 تم إنهاء المكالمة</span>';
      setTimeout(() => window.location.href = '<%= backUrl %>', 1500);
    }

    // Timeout fallback
    setTimeout(() => {
      const status = document.getElementById('callStatus');
      if (status.innerHTML.includes('بانتظار')) {
        status.innerHTML = '⏳ لم يتم الاتصال... تأكد من وجود الطرف الآخر';
      }
    }, 15000);
  </script>
</body>
</html>