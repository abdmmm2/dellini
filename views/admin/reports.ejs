<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold"><i class="bi bi-graph-up"></i> التقارير المالية</h3>
    <div>
      <div class="btn-group btn-group-sm">
        <a href="/admin/reports?period=today" class="btn <%= period === 'today' ? 'btn-primary' : 'btn-outline-primary' %>">اليوم</a>
        <a href="/admin/reports?period=week" class="btn <%= period === 'week' ? 'btn-primary' : 'btn-outline-primary' %>">آخر 7 أيام</a>
        <a href="/admin/reports?period=month" class="btn <%= period === 'month' ? 'btn-primary' : 'btn-outline-primary' %>">آخر 30 يوم</a>
        <a href="/admin/reports?period=year" class="btn <%= period === 'year' ? 'btn-primary' : 'btn-outline-primary' %>">آخر سنة</a>
        <a href="/admin/reports" class="btn <%= period === 'all' ? 'btn-primary' : 'btn-outline-primary' %>">الكل</a>
      </div>
      <a href="/admin/reports/export-pdf?period=<%= period %>" class="btn btn-danger btn-sm ms-2" target="_blank">
        <i class="bi bi-filetype-pdf"></i> تصدير PDF
      </a>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card bg-primary text-white text-center p-3">
        <div class="h3 fw-bold"><%= summary.total_revenue %> ريال</div>
        <div class="small opacity-75">إجمالي الإيرادات</div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white text-center p-3">
        <div class="h3 fw-bold"><%= summary.total_fees %> ريال</div>
        <div class="small opacity-75">عمولات المنصة</div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-danger text-white text-center p-3">
        <div class="h3 fw-bold"><%= summary.total_withdrawals %> ريال</div>
        <div class="small opacity-75">إجمالي المسحوبات</div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-info text-white text-center p-3">
        <div class="h3 fw-bold"><%= summary.payment_count %></div>
        <div class="small opacity-75">عدد المعاملات</div>
      </div>
    </div>
  </div>

  <!-- Commission Info -->
  <div class="card bg-light mb-4">
    <div class="card-body">
      <div class="row text-center">
        <div class="col-4">
          <div class="fw-bold h4 text-primary"><%= summary.payment_count > 0 ? (summary.total_fees / summary.payment_count).toFixed(2) : 0 %> ريال</div>
          <div class="small text-muted">متوسط العمولة لكل استشارة</div>
        </div>
        <div class="col-4">
          <div class="fw-bold h4 text-success">25%</div>
          <div class="small text-muted">نسبة عمولة المنصة</div>
        </div>
        <div class="col-4">
          <div class="fw-bold h4"><%= summary.total_revenue - summary.total_withdrawals %> ريال</div>
          <div class="small text-muted">صافي الإيرادات</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Transactions Table -->
  <div class="card shadow-sm">
    <div class="card-header bg-white">
      <h5 class="fw-bold mb-0"><i class="bi bi-list-ol"></i> سجل المعاملات</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>#</th>
              <th>المستخدم</th>
              <th>الاستشارة</th>
              <th>النوع</th>
              <th>المبلغ</th>
              <th>عمولة المنصة</th>
              <th>الحالة</th>
              <th>التاريخ</th>
            </tr>
          </thead>
          <tbody>
            <% if (transactions.length === 0) { %>
              <tr><td colspan="8" class="text-center py-4 text-muted">لا توجد معاملات</td></tr>
            <% } %>
            <% transactions.forEach(t => { %>
              <tr>
                <td>#<%= t.id %></td>
                <td><%= t.user_name || '—' %></td>
                <td><%= t.title || t.question?.substring(0, 30) || '—' %></td>
                <td>
                  <span class="badge <%= t.type === 'payment' ? 'bg-success' : t.type === 'withdrawal' ? 'bg-danger' : 'bg-info' %>">
                    <%= t.type === 'payment' ? 'دفع' : t.type === 'withdrawal' ? 'سحب' : t.type === 'fee' ? 'رسوم' : t.type %>
                  </span>
                </td>
                <td class="fw-bold"><%= t.amount %> ريال</td>
                <td><%= t.platform_fee || 0 %> ريال</td>
                <td>
                  <span class="badge bg-<%= t.status === 'completed' ? 'success' : 'warning' %>">
                    <%= t.status === 'completed' ? 'مكتمل' : t.status %>
                  </span>
                </td>
                <td class="small"><%= new Date(t.created_at).toLocaleDateString('ar-SA') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
