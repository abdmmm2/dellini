<div class="container py-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-shield-check"></i> النسخ الاحتياطي</h4>
    <form method="POST" action="/admin/backup/create" style="display:inline">
      <button type="submit" class="btn btn-success">
        <i class="bi bi-cloud-arrow-up"></i> إنشاء نسخة احتياطية
      </button>
    </form>
  </div>

  <!-- Stats Cards -->
  <div class="row g-2 mb-3">
    <div class="col-4">
      <div class="card text-center p-2 border-0 shadow-sm" style="border-radius:12px">
        <div class="fw-bold text-primary fs-5"><%= stats.users %></div>
        <small class="text-muted">مستخدم</small>
      </div>
    </div>
    <div class="col-4">
      <div class="card text-center p-2 border-0 shadow-sm" style="border-radius:12px">
        <div class="fw-bold text-success fs-5"><%= stats.consultations %></div>
        <small class="text-muted">استشارة</small>
      </div>
    </div>
    <div class="col-4">
      <div class="card text-center p-2 border-0 shadow-sm" style="border-radius:12px">
        <div class="fw-bold text-warning fs-5"><%= stats.consultants %></div>
        <small class="text-muted">مستشار</small>
      </div>
    </div>
  </div>

  <!-- Existing Backups -->
  <% if (backups.length > 0) { %>
    <h6 class="fw-bold mb-2">النسخ الاحتياطية السابقة</h6>
    <div class="list-group mb-3">
      <% backups.forEach(b => { %>
        <div class="list-group-item d-flex justify-content-between align-items-center py-2">
          <div>
            <i class="bi bi-file-earmark-zip text-primary"></i>
            <span class="ms-1"><%= b.name %></span>
            <small class="text-muted ms-2">(<%= (b.size / 1024).toFixed(1) %> KB)</small>
            <br>
            <small class="text-muted"><%= b.time.toLocaleString('ar-SA') %></small>
          </div>
          <div class="d-flex gap-1">
            <a href="/admin/backup/download/<%= b.name %>" class="btn btn-sm btn-outline-primary" title="تحميل">
              <i class="bi bi-download"></i>
            </a>
            <form method="POST" action="/admin/backup/restore" style="display:inline" onsubmit="return confirm('استعادة هذه النسخة؟ سيتم استبدال قاعدة البيانات الحالية.')">
              <input type="hidden" name="name" value="<%= b.name %>">
              <button type="submit" class="btn btn-sm btn-outline-warning" title="استعادة">
                <i class="bi bi-arrow-counterclockwise"></i>
              </button>
            </form>
            <form method="POST" action="/admin/backup/delete" style="display:inline" onsubmit="return confirm('حذف النسخة؟')">
              <input type="hidden" name="name" value="<%= b.name %>">
              <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="text-center text-muted py-4">
      <i class="bi bi-inbox fs-2"></i>
      <p class="mb-0">لا توجد نسخ احتياطية بعد</p>
      <small>اضغط "إنشاء نسخة احتياطية" لعمل أول نسخة</small>
    </div>
  <% } %>

  <!-- Upload & Restore from file -->
  <div class="card border-0 shadow-sm mb-3" style="border-radius:12px">
    <div class="card-body">
      <h6 class="fw-bold"><i class="bi bi-upload"></i> استعادة من ملف</h6>
      <p class="small text-muted">ارفع ملف قاعدة بيانات (.db) لاستبدال قاعدة البيانات الحالية.</p>
      <form method="POST" action="/admin/backup/upload-restore" enctype="multipart/form-data" onsubmit="return confirm('استبدال قاعدة البيانات الحالية بالملف المرفوع؟')">
        <div class="mb-2">
          <input type="file" name="dbfile" accept=".db" class="form-control form-control-sm" required>
        </div>
        <button type="submit" class="btn btn-warning btn-sm">
          <i class="bi bi-upload"></i> رفع واستعادة
        </button>
      </form>
    </div>
  </div>

  <!-- ⚡ استعادة سريعة -->
  <div class="card border-0 shadow-sm mb-3" style="border-radius:12px;border:2px solid #ffc107 !important">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h6 class="fw-bold mb-1"><i class="bi bi-lightning-charge text-warning"></i> استعادة سريعة</h6>
          <p class="small text-muted mb-0">استعادة قاعدة البيانات من آخر نسخة احتياطية تلقائية.</p>
        </div>
        <form method="POST" action="/admin/backup/restore-latest" onsubmit="return confirm('استبدال قاعدة البيانات الحالية بآخر نسخة احتياطية؟')">
          <button type="submit" class="btn btn-warning">
            <i class="bi bi-arrow-counterclockwise"></i> استعادة
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Auto-backup info -->
  <div class="alert alert-info py-2 mb-0" style="border-radius:12px">
    <i class="bi bi-info-circle"></i>
    <small>
      <strong>ملاحظة:</strong> بعد الاستعادة، أعد تشغيل السيرفر (Manual Deploy) عشان التغييرات تطبق.<br>
      النسخ تخزّن على القرص الدائم (<%= process.env.DB_PATH || '/data/dellini.db' %>) وما تروح مع إعادة النشر 💾
    </small>
  </div>
</div>