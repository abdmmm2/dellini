<% // Verification Badge Preview (HTML fragment for AJAX)
var vTier = typeof tier !== 'undefined' ? tier : 'none';
if (vTier === 'none') { %><span style="color:#999">❌ غير موثّق</span><% return; }

var tierData = {
  black: { name: 'موثّق أسود', stars: '15,000' },
  blue: { name: 'موثّق أزرق', stars: '30,000' },
  silver: { name: 'موثّق فضي', stars: '50,000' },
  gold: { name: 'موثّق ذهبي', stars: '80,000' },
  platinum: { name: 'موثّق بلاتيني', stars: '100,000' }
};
var info = tierData[vTier] || { name: 'موثّق', stars: '' };
%>
<span class="verify-badge verify-<%= vTier %> verify-badge-lg">
  <span class="badge-icon">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2z"/>
    </svg>
  </span>
  <span class="badge-check">✓</span>
  <span><%= info.name %></span>
</span>
