<div class="container py-3">
  <h4 class="fw-bold mb-3"><i class="bi bi-card-text"></i> التحقق من الهويات</h4>

  <% if (verifications.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-inbox fs-1 text-muted"></i>
      <p class="text-muted mt-2">لا توجد طلبات توثيق هوية بعد</p>
    </div>
  <% } %>

  <div class="row g-3">
    <% verifications.forEach(v => { %>
      <div class="col-12">
        <div class="card shadow-sm" style="border-radius:14px;border:2px solid <%=
          v.status === 'verified' ? '#198754' : v.status === 'rejected' ? '#dc3545' : '#ffc107'
        %>">
          <div class="card-body">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h6 class="fw-bold mb-1"><%= v.user_name || 'غير معروف' %></h6>
                <small class="text-muted"><%= v.email %> · 📞 <%= v.phone || '—' %></small>
                <br>
                <span class="badge <%=
                  v.status === 'verified' ? 'bg-success' : v.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark'
                %> mt-1">
                  <%= v.status === 'verified' ? '✅ موثق' : v.status === 'rejected' ? '❌ مرفوض' : '⏳ قيد المراجعة' %>
                </span>
                <a href="/admin/identity/pdf/<%= v.id %>" class="btn btn-sm btn-outline-danger ms-1" title="تصدير PDF">
                  <i class="bi bi-filetype-pdf"></i>
                </a>
                <button onclick="printIdentity(<%= v.id %>, '<%= v.user_name || '' %>', '<%= v.email || '' %>', '<%= v.phone || '' %>', '<%= v.id_number || '' %>', '<%= v.full_name || '' %>', '<%= v.issuer || '' %>', '<%= v.issue_date || '' %>', '<%= v.expiry_date || '' %>', '<%= v.birth_date || '' %>', '<%= v.age || '' %>', '<%= v.image_path || '' %>', '<%= v.status %>')" class="btn btn-sm btn-outline-secondary ms-1" title="طباعة A4">
                  <i class="bi bi-printer"></i>
                </button>
              </div>
              <small class="text-muted"><%= v.created_at %></small>
            </div>

            <div class="row g-2 mt-2">
              <!-- ID Image -->
              <div class="col-md-4">
                <% if (v.image_path) { %>
                  <img src="<%= v.image_path %>" class="img-fluid rounded" style="max-height:200px;width:100%;object-fit:contain;background:#f8f9fa" alt="الهوية">
                <% } else { %>
                  <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:150px">
                    <span class="text-muted">لا توجد صورة</span>
                  </div>
                <% } %>
              </div>

              <!-- Manual Edit Form -->
              <div class="col-md-8">
                <form method="POST" action="/admin/identity/update/<%= v.id %>">
                  <div class="row g-2">
                    <div class="col-md-6">
                      <label class="small fw-bold">الاسم</label>
                      <input type="text" name="full_name" class="form-control form-control-sm" value="<%= v.full_name || '' %>" placeholder="—">
                    </div>
                    <div class="col-md-6">
                      <label class="small fw-bold">رقم الهوية</label>
                      <input type="text" name="id_number" class="form-control form-control-sm" value="<%= v.id_number || '' %>" placeholder="—">
                    </div>
                    <div class="col-md-6">
                      <label class="small fw-bold">المصدر</label>
                      <input type="text" name="issuer" class="form-control form-control-sm" value="<%= v.issuer || '' %>" placeholder="—">
                    </div>
                    <div class="col-md-6">
                      <label class="small fw-bold">تاريخ الإصدار</label>
                      <input type="text" name="issue_date" class="form-control form-control-sm" value="<%= v.issue_date || '' %>" placeholder="مثال: 1440/01/01">
                    </div>
                    <div class="col-md-6">
                      <label class="small fw-bold">تاريخ الانتهاء</label>
                      <input type="text" name="expiry_date" class="form-control form-control-sm" value="<%= v.expiry_date || '' %>" placeholder="مثال: 1448/01/01">
                    </div>
                    <div class="col-md-6">
                      <label class="small fw-bold">تاريخ الميلاد</label>
                      <input type="text" name="birth_date" class="form-control form-control-sm" value="<%= v.birth_date || '' %>" placeholder="مثال: 1410/01/01">
                    </div>
                    <div class="col-md-6">
                      <label class="small fw-bold">العمر</label>
                      <input type="text" name="age" class="form-control form-control-sm" value="<%= v.age || '' %>" placeholder="—">
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                      <button type="submit" class="btn btn-warning btn-sm w-100">
                        <i class="bi bi-pencil"></i> حفظ البيانات
                      </button>
                    </div>
                  </div>
                </form>
              </div>
            </div>

            <!-- OCR Raw Text -->
            <% if (v.ocr_raw_text) { %>
              <details class="mt-2">
                <summary class="small text-muted">📝 النص المستخرج (OCR)</summary>
                <pre class="small bg-light p-2 mt-1 rounded" style="max-height:100px;overflow:auto;white-space:pre-wrap;font-size:0.7rem;direction:ltr;text-align:left"><%= v.ocr_raw_text %></pre>
              </details>
            <% } %>

            <!-- Approve/Reject -->
            <% if (v.status === 'pending') { %>
              <div class="d-flex gap-2 mt-2">
                <form method="POST" action="/admin/identity/action" style="display:inline">
                  <input type="hidden" name="id" value="<%= v.id %>">
                  <input type="hidden" name="action" value="approve">
                  <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> توثيق</button>
                </form>
                <form method="POST" action="/admin/identity/action" style="display:inline">
                  <input type="hidden" name="id" value="<%= v.id %>">
                  <input type="hidden" name="action" value="reject">
                  <div class="input-group input-group-sm">
                    <input type="text" name="note" class="form-control form-control-sm" placeholder="سبب الرفض" style="max-width:200px">
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-x-lg"></i> رفض</button>
                  </div>
                </form>
              </div>
            <% } else if (v.admin_note) { %>
              <div class="small text-muted mt-1">📝 ملاحظة: <%= v.admin_note %></div>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<!-- 🖨️ Print A4 Script -->
<div id="printArea" style="display:none"></div>
<script>
function printIdentity(id, userName, email, phone, idNumber, fullName, issuer, issueDate, expiryDate, birthDate, age, imagePath, status) {
  const statusText = status === 'verified' ? '✅ موثق' : status === 'rejected' ? '❌ مرفوض' : '⏳ قيد المراجعة';
  
  const html = '<!DOCTYPE html><html dir="rtl" lang="ar"><head><meta charset="UTF-8">'
    + '<title>الهوية الوطنية - ' + userName + '</title>'
    + '<style>'
    + '@page { size: A4; margin: 15mm; }'
    + '* { margin:0; padding:0; box-sizing:border-box; }'
    + 'body { font-family: "Tajawal", Arial, sans-serif; color: #333; padding: 20px; }'
    + '.header { text-align: center; border-bottom: 3px solid #1a2332; padding-bottom: 15px; margin-bottom: 20px; }'
    + '.header h1 { color: #1a2332; font-size: 24px; }'
    + '.header p { color: #c8a45c; font-size: 14px; }'
    + '.id-container { display: flex; gap: 20px; margin-bottom: 20px; }'
    + '.id-image { width: 40%; border: 1px solid #ddd; border-radius: 8px; padding: 5px; }'
    + '.id-image img { width: 100%; height: auto; }'
    + '.id-data { width: 60%; }'
    + 'table { width: 100%; border-collapse: collapse; }'
    + 'th, td { text-align: right; padding: 10px 12px; border-bottom: 1px solid #eee; font-size: 14px; }'
    + 'th { background: #f5f5f5; color: #1a2332; width: 40%; font-weight: 700; }'
    + '.status-badge { display: inline-block; padding: 4px 14px; border-radius: 20px; font-size: 13px; font-weight: 700; }'
    + '.status-verified { background: #d4edda; color: #155724; }'
    + '.status-pending { background: #fff3cd; color: #856404; }'
    + '.status-rejected { background: #f8d7da; color: #721c24; }'
    + '.footer { margin-top: 30px; text-align: center; font-size: 11px; color: #999; border-top: 1px solid #eee; padding-top: 15px; }'
    + '.id-card-preview { border: 2px dashed #c8a45c; border-radius: 8px; padding: 10px; text-align: center; margin-bottom: 20px; background: #fafafa; }'
    + '.id-card-preview h3 { color: #1a2332; margin-bottom: 5px; }'
    + '@media print { body { padding: 0; } .no-print { display: none; } }'
    + '</style></head><body>'
    + '<div class="header">'
    + '<h1>دلني</h1>'
    + '<p>منصة استشارات إلكترونية — التحقق من الهوية</p>'
    + '</div>'
    + '<div style="text-align:left;margin-bottom:10px">'
    + '<span class="status-badge status-' + status + '">' + statusText + '</span>'
    + '</div>'
    + '<div class="id-container">'
    + '<div class="id-image">'
    + (imagePath ? '<img src="' + imagePath + '" alt="الهوية">' : '<div style="background:#eee;height:150px;display:flex;align-items:center;justify-content:center;color:#999">لا توجد صورة</div>')
    + '</div>'
    + '<div class="id-data">'
    + '<table>'
    + '<tr><th>الاسم</th><td>' + (fullName || '—') + '</td></tr>'
    + '<tr><th>رقم الهوية</th><td style="direction:ltr;text-align:right">' + (idNumber || '—') + '</td></tr>'
    + '<tr><th>المصدر</th><td>' + (issuer || '—') + '</td></tr>'
    + '<tr><th>تاريخ الإصدار</th><td>' + (issueDate || '—') + '</td></tr>'
    + '<tr><th>تاريخ الانتهاء</th><td>' + (expiryDate || '—') + '</td></tr>'
    + '<tr><th>تاريخ الميلاد</th><td>' + (birthDate || '—') + '</td></tr>'
    + '<tr><th>العمر</th><td>' + (age || '—') + '</td></tr>'
    + '</table></div></div>'
    + '<div class="id-card-preview">'
    + '<h3>📋 معلومات المستخدم</h3>'
    + '<p><strong>الاسم:</strong> ' + userName + ' | <strong>البريد:</strong> ' + email + ' | <strong>الجوال:</strong> ' + phone + '</p>'
    + '</div>'
    + '<div class="footer">'
    + '<p>تم إنشاء هذا التقرير في ' + new Date().toLocaleString('ar-SA') + '</p>'
    + '<p>دلني للاستشارات © ' + new Date().getFullYear() + '</p>'
    + '</div>'
    + '<div class="no-print" style="text-align:center;margin-top:20px">'
    + '<button onclick="window.print()" style="padding:10px 30px;background:#1a2332;color:#fff;border:none;border-radius:8px;cursor:pointer">🖨️ طباعة</button>'
    + '</div>'
    + '</body></html>';
  
  const w = window.open('', '_blank', 'width=800,height=600');
  w.document.write(html);
  w.document.close();
}
</script>